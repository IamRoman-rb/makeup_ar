rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin = campo is_admin == true en SU documento de users. Ese campo solo
    // se puede poner desde la consola de Firebase o con el Admin SDK: el
    // cliente nunca lo puede escribir (ver match /users).
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_admin', false) == true;
    }

    // Estado VIP: lo escribe solo el servidor (webhook de RevenueCat,
    // functions/src/revenueCatWebhook.ts) o un admin desde la consola. Se
    // compara el vencimiento con request.time: vence solo aunque se pierda un
    // evento. is_premium (viejo) no cuenta: cualquiera lo pudo escribir.
    function serverFields() {
      return ['is_premium', 'premium_until', 'premium_event_ms'];
    }

    function premiumUntil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premium_until', null);
    }

    function isPremium() {
      return isSignedIn() && premiumUntil() is timestamp && premiumUntil() > request.time;
    }

    // Campos de receta de un look o borrador del Studio (F3), si vienen. El
    // contenido de la receta lo valida la app con el esquema JSON antes de
    // escribir y al leer (RecipeValidator); acá solo se cuidan los tipos.
    function validRecipeFields(data) {
      return (!('recipe' in data) || data.recipe is map)
        && (!('minEngine' in data) || data.minEngine is int)
        && (!('recipeSchema' in data) || data.recipeSchema == 'makeup-recipe/2');
    }

    // "looks" es el catálogo: cualquiera lo puede leer (con o sin login),
    // pero solo un usuario admin puede crear/editar/borrar looks.
    match /looks/{lookId} {
      allow read: if true;
      allow create, update: if isAdmin() && validRecipeFields(request.resource.data);
      allow delete: if isAdmin();
    }

    // Contenido pago de un look (hoy la URL del video del tutorial): solo VIP
    // vigentes y admins. Antes video_url estaba en el look, de lectura pública
    // (AUDIT.md §5.2).
    match /looks/{lookId}/premium/{docId} {
      allow read: if isAdmin() || isPremium();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['video_url'])
        && request.resource.data.video_url is string;
      allow delete: if isAdmin();
    }

    // Borradores del Studio (F3): solo admins, y siempre con una receta.
    // Separados de "looks" para que el catálogo siga con lectura pública sin
    // filtrar por estado (las reglas no filtran consultas).
    match /look_drafts/{draftId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.recipe is map
        && validRecipeFields(request.resource.data);
    }

    // "users" tiene datos personales (correo, edad, fecha de nacimiento).
    // Cada usuario solo puede leer/escribir SU PROPIO documento, y NUNCA el
    // campo is_admin: antes cualquiera podía ponerse is_admin: true y editar
    // o borrar todo el catálogo (docs/ar_engine/AUDIT.md §5.1). Tampoco el
    // estado VIP (serverFields): antes cualquiera se marcaba VIP (§5.2).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.get('is_admin', false) == false
        && !request.resource.data.keys().hasAny(serverFields());
      allow update: if isOwner(userId)
        && request.resource.data.get('is_admin', false) == resource.data.get('is_admin', false)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields());
      allow delete: if isOwner(userId);
    }

    // Looks generados por usuarios finales ("Mis looks"; motor_ar_propio.md
    // §10.12): el dueño los lee; los escriben y borran solo las callables
    // saveAiLook/deleteAiLook (Admin SDK), que validan la receta con el esquema
    // y ponen el tope por usuario. users/{uid}/usage sigue sin regla: sin acceso.
    match /users/{userId}/ai_looks/{lookId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
  }
}
